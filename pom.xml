<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.himanshupawar</groupId>
  <artifactId>selenium-ddf-framework</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>Selenium Data-Driven Testing Framework</name>
  <description>
    Selenium 4 + TestNG UI automation framework with a Page Object Model,
    CSV-driven test data, and ExtentReports, targeting the public Sauce Labs
    demo site (https://www.saucedemo.com). Built as an SDET portfolio project.
  </description>
  <url>https://github.com/himanshupawar26/Selenium-AutomationTesting-DDF-Framework</url>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>

    <selenium.version>4.27.0</selenium.version>
    <testng.version>7.10.2</testng.version>
    <extentreports.version>5.1.2</extentreports.version>
    <commons-csv.version>1.11.0</commons-csv.version>
    <assertj.version>3.26.3</assertj.version>
    <slf4j.version>2.0.12</slf4j.version>

    <!-- Overridable via -Dbrowser=... / -Dheadless=... -->
    <browser>chrome</browser>
    <headless>true</headless>
    <baseUrl>https://www.saucedemo.com</baseUrl>
  </properties>

  <dependencies>
    <!-- Selenium WebDriver — Selenium Manager (built in since 4.6) resolves
         the matching browser driver automatically, no driver binaries needed -->
    <dependency>
      <groupId>org.seleniumhq.selenium</groupId>
      <artifactId>selenium-java</artifactId>
      <version>${selenium.version}</version>
    </dependency>

    <!-- TestNG -->
    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
      <version>${testng.version}</version>
    </dependency>

    <!-- ExtentReports -->
    <dependency>
      <groupId>com.aventstack</groupId>
      <artifactId>extentreports</artifactId>
      <version>${extentreports.version}</version>
    </dependency>

    <!-- CSV-driven test data (replaces the old Apache POI/Excel reader —
         plain text, diffable in PRs, no binary files in git) -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-csv</artifactId>
      <version>${commons-csv.version}</version>
    </dependency>

    <!-- AssertJ for fluent assertions -->
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
    </dependency>

    <!-- Logging -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
  </dependencies>

  <build>
    <testResources>
      <testResource>
        <directory>src/test/resources</directory>
      </testResource>
    </testResources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>17</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <suiteXmlFiles>
            <suiteXmlFile>testng.xml</suiteXmlFile>
          </suiteXmlFiles>
          <systemPropertyVariables>
            <browser>${browser}</browser>
            <headless>${headless}</headless>
            <baseUrl>${baseUrl}</baseUrl>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
